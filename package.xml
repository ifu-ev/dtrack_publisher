<?xml version="1.0"?>
<package format="2">
  <name>dtrack_publisher</name>
  <version>0.0.1</version>
  <description>Publishes pose data from DTrack3 over UDP and builds a visual path</description>

  <maintainer email="krininger.matthew@gmail.com">Matthew Krininger</maintainer>
  <license>MIT</license>

  <!-- Required build tools -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Runtime and build-time dependencies -->
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Export -->
  <export>
  </export>
</package>
