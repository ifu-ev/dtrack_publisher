<?xml version="1.0"?>
<package format="3">
  <name>dtrack_publisher</name>
  <version>0.1.0</version>
  <description>Publishes multi-body pose and path data received from DTrack3 over UDP.</description>

  <maintainer email="david.schnermann@ifu.rwth-aachen.de">David Schnermann</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
